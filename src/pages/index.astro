---
import Base from "../layouts/Base.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { getJournalPosts, getPosts, getCardImage, getExcerpt } from "../lib/blog";
import { socialLinks, sites } from "../lib/links";

const journal = await getJournalPosts();
const latest = (journal.length ? journal : await getPosts()).slice(0, 4);
const tagline = "Ni développeur, ni designer, ni gourou. J'aime juste créer des trucs sur internet.";
---

<Base title="Dário Pinheiro" description={tagline} image="/images/dario.png">
  <div class="home">
    <div class="glow" aria-hidden="true"><i></i><i></i><i></i></div>

    <header class="profile">
      <div class="avatar">
        <img src="/images/dario.png" alt="Dário Pinheiro" width="112" height="112" fetchpriority="high" />
      </div>
      <h1>Dário Pinheiro</h1>
      <p class="tag">{tagline}</p>
    </header>

    {socialLinks.length > 0 && (
      <section class="reveal">
        <p class="label">Me retrouver</p>
        <div class="pills">
          {socialLinks.map((l) => (
            <a href={l.url} rel="noopener" target="_blank">{l.name}{l.text ? ` · ${l.text}` : ""}</a>
          ))}
        </div>
      </section>
    )}

    <section class="reveal">
      <p class="label">Explorer</p>
      <a class="card" href="/blog/">
        <div class="thumb t1"></div>
        <div><h3>Lire le blog</h3><p>Sites, pivots, échecs et petites victoires, racontés à la première personne.</p></div>
      </a>
      {sites.map((s) => (
        <a class="card" href={s.url} rel="noopener">
          <div class="thumb t2"></div>
          <div><h3>{s.name}</h3>{s.text && <p>{s.text}</p>}</div>
        </a>
      ))}
    </section>

    {latest.length > 0 && (
      <section class="reveal">
        <div class="head"><b>Mes derniers articles</b><a href="/blog/">Tout voir ›</a></div>
        {latest.map((p) => {
          const img = getCardImage(p);
          const ex = getExcerpt(p);
          return (
            <a class="card" href={`/blog/${p.id}/`}>
              <img class="thumb" src={img.url} alt={img.alt} loading="lazy" width="120" height="96" />
              <div><h3>{p.data.title}</h3>{ex && <p>{ex}</p>}</div>
            </a>
          );
        })}
      </section>
    )}

    <section class="reveal join">
      <h2>Rejoins la<br />lettre</h2>
      <NewsletterForm
        id="home"
        title="La lettre"
        text="La suite de la route, par e-mail : les sites, ce qui marche, ce qui rate. Pas de spam, désinscription en un clic."
      />
    </section>
  </div>
</Base>

<script>
  const io = new IntersectionObserver(
    (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } }),
    { threshold: 0.12 },
  );
  document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
</script>

<style>
  .home { position: relative; max-width: 520px; margin: 0 auto; padding: 0 4px 24px; --ease: cubic-bezier(.23,1,.32,1); }
  .glow { position: absolute; left: 50%; top: -80px; width: 100vw; height: 320px; transform: translateX(-50%); overflow: hidden; pointer-events: none; z-index: -1; }
  .glow i { position: absolute; border-radius: 50%; filter: blur(60px); background: #e9a083; }
  .glow i:nth-child(1) { width: 360px; height: 220px; left: -60px; top: -80px; opacity: .9; }
  .glow i:nth-child(2) { width: 300px; height: 200px; right: -40px; top: -60px; background: #f4c8b4; opacity: .9; }
  .glow i:nth-child(3) { width: 260px; height: 160px; left: 30%; top: -40px; background: #f0b59c; opacity: .7; }
  .glow::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to bottom, transparent 40%, #fff); }

  .profile { text-align: center; padding-top: 72px; }
  .avatar { width: 112px; height: 112px; margin: 0 auto 14px; border-radius: 50%; overflow: hidden; border: 3px solid #fff; box-shadow: 0 8px 30px rgba(233,160,131,.35); background: #fff; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  h1 { margin: 0; font-size: 30px; font-weight: 500; letter-spacing: -.04em; }
  .tag { margin: 8px auto 0; max-width: 360px; color: #555; font-size: 17px; line-height: 1.45; }

  section { margin-top: 44px; }
  .label { margin: 0 0 14px; text-align: center; font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: #8a8a85; }
  .pills { display: flex; justify-content: center; flex-wrap: wrap; gap: 8px; }
  .pills a { padding: 10px 18px; border-radius: 999px; background: #f6f6f4; border: 1px solid #e6e6e2; color: #111; text-decoration: none; font-size: 14px; transition: transform .2s var(--ease); }
  .pills a:active { transform: scale(.97); }

  .card { display: flex; gap: 14px; align-items: center; background: #fbfbfa; border-radius: 18px; padding: 10px; margin-bottom: 10px; color: #111; text-decoration: none; box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 6px 20px rgba(0,0,0,.03); transition: transform .2s var(--ease); }
  .card:active { transform: scale(.98); }
  @media (hover: hover) and (pointer: fine) { .card:hover { transform: translateY(-2px); } }
  .thumb { width: 120px; height: 96px; border-radius: 12px; flex: none; object-fit: cover; }
  .t1 { background: linear-gradient(135deg, #f0c9a5, #e0a07e); }
  .t2 { background: linear-gradient(135deg, #d9c4ee, #b4d9cf); }
  .card h3 { margin: 0; font-size: 15px; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }
  .card p { margin: 4px 0 0; font-size: 13px; color: #8a8a85; line-height: 1.35; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }

  .head { display: flex; justify-content: space-between; align-items: baseline; margin: 0 4px 10px; font-size: 13px; }
  .head b { font-weight: 500; letter-spacing: -.02em; }
  .head a { font-size: 12px; color: #8a8a85; text-decoration: none; }

  .join { text-align: center; }
  .join h2 { margin: 0 0 8px; font-size: 38px; font-weight: 500; letter-spacing: -.05em; line-height: 1.05; }

  .reveal { opacity: 0; transform: translateY(12px); transition: opacity .5s var(--ease), transform .5s var(--ease); }
  .reveal:global(.in) { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; transition: none; } }
</style>
