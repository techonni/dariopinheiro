---
import Base from "../layouts/Base.astro";

// Hub de links (como um « link na bio »). Cada grupo é uma lista de botões.
// Para acrescentar um link, copiar uma linha. Links com url vazio não aparecem.
const groups = [
  {
    title: "Work",
    links: [
      { name: "Techonni", text: "Guias de GTA 6 em francês", url: "https://techonni.com" },
      { name: "Zunrel", text: "Guias de Leadpages, HTML Pub e Shopify", url: "https://zunrel.com" },
      { name: "Pieceworth", text: "Guias para comprar luxo com cuidado", url: "https://pieceworth.com" },
    ],
  },
  {
    title: "Jogos",
    links: [{ name: "Jogo", text: "Para jogar no navegador", url: "https://game.zunrel.com" }],
  },
  {
    title: "Redes",
    links: [
      { name: "Instagram", text: "", url: "" },
      { name: "YouTube", text: "", url: "" },
      { name: "TikTok", text: "", url: "" },
      { name: "LinkedIn", text: "", url: "" },
      { name: "E-mail", text: "", url: "" },
    ],
  },
]
  .map((g) => ({ ...g, links: g.links.filter((l) => l.url) }))
  .filter((g) => g.links.length);

const host = (url: string) => (url.startsWith("mailto:") ? url.slice(7) : new URL(url).host);
---

<Base title="Dário Pinheiro" description="Dário Pinheiro: todos os meus links num só sítio.">
  <div class="hub">
    <h1>Dário Pinheiro</h1>
    <p class="lead">Todos os meus sites e links num só sítio.</p>
    <p class="lead todo">[a preencher: uma frase sobre si]</p>

    {groups.map((g) => (
      <section>
        <h2 class="section-title">{g.title}</h2>
        <ul class="buttons">
          {g.links.map((l) => (
            <li>
              <a class="button" href={l.url} target="_blank" rel="noopener">
                <span>
                  <span class="button-name">{l.name}</span>
                  {l.text && <span class="button-text">{l.text}</span>}
                </span>
                <span class="button-meta">{host(l.url)} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <p class="lead todo">[a preencher: links das suas redes e e-mail]</p>
  </div>
</Base>
