---
import Base from "../layouts/Base.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { getPosts, readingMinutes } from "../lib/blog";
import { host, socialLinks } from "../lib/links";

// Página inicial (pedido do Dário, 04/10/2026): só três blocos, por esta ordem:
// 1) os guias do blog em destaque, 2) a newsletter, 3) o X.
// Os sites (« Work ») e o jogo estão no menu lateral (src/components/MenuDrawer.astro, links em src/lib/links.ts).
// Guias em destaque: escolher os slugs aqui (ficheiros em src/content/blog/).
const featuredSlugs = [
  "erreurs-a-eviter-et-workflow-ia",
  "choisir-une-niche-avec-l-ia",
  "ecrire-des-guides-avec-l-ia-sans-spam",
  "etude-de-cas-zunrel",
  "etude-de-cas-pieceworth",
  "etude-de-cas-techonni",
];
const posts = await getPosts();
const featured = featuredSlugs.map((slug) => posts.find((p) => p.id === slug)).filter((p) => p !== undefined);
---

<Base title="Dário Pinheiro" description="Dário Pinheiro : je crée des sites d'affiliation avec l'IA, et je montre comment faire. Guides pratiques, newsletter et liens.">
  <div class="hub">
    <header class="intro">
      <picture>
        <source srcset="/images/dario.webp" type="image/webp" />
        <img class="avatar" src="/images/dario.jpg" alt="Dario" width="96" height="96" fetchpriority="high" />
      </picture>
      <h1>Dario</h1>
      <p class="lead">I make stuff on the internet.</p>
      <p class="lead-more">Je crée des sites d'affiliation avec l'IA, et je montre comment faire.</p>
    </header>

    <section class="featured">
      <h2 class="section-title">Blog</h2>
      <p class="section-intro">Des guides pratiques, étape par étape, tirés de mes vrais sites.</p>
      <ul class="post-list">
        {featured.map((p) => (
          <li>
            <a class="post-card" href={`/blog/${p.id}/`}>
              <span class="post-title">{p.data.title}</span>
              <span class="post-summary">{p.data.summary}</span>
              <span class="post-meta">{readingMinutes(p)} min de lecture</span>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="featured-more"><a class="pill-link" href="/blog/">Tous les guides ({posts.length})</a></p>
    </section>

    <NewsletterForm />

    {socialLinks.length > 0 && (
      <section>
        <h2 class="section-title">Réseaux</h2>
        <ul class="items">
          {socialLinks.map((l) => (
            <li>
              <a class="item" href={l.url} target="_blank" rel="noopener">
                <span class="item-name">{l.name} <span class="arrow" aria-hidden="true">→</span></span>
                {l.text && <span class="item-text">{l.text}</span>}
                <span class="item-meta">{host(l.url)} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Base>
