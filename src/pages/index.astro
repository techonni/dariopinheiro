---
import Base from "../layouts/Base.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { formatDateShort, getJournalPosts, getPosts } from "../lib/blog";

const journal = await getJournalPosts();
const latest = journal.length ? journal.slice(0, 6) : (await getPosts()).slice(0, 6);
const tagline = "Ni développeur, ni designer, ni gourou. J'aime juste créer des trucs sur internet.";
---

<Base title="Dário Pinheiro" description={tagline} image="/images/dario.png">
  <div class="home">
    <div class="who">
      <img src="/images/dario.png" alt="Dario" width="64" height="64" fetchpriority="high" />
      <div>
        <b>Dario</b>
        <p class="tag">{tagline}</p>
      </div>
    </div>

    <p class="intro">
      Ici, je raconte ce que je construis sur internet : sites, pivots, échecs et petites victoires.
      Un article le soir, à la première personne.
    </p>

    <p class="actions">
      <a class="btn" href="/blog/">Lire le blog →</a>
    </p>

    <p class="k">Récents</p>
    <ul class="home-list">
      {latest.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>
            <span class="t">{p.data.title}</span>
            <span class="d">{formatDateShort(p.data.published)} →</span>
          </a>
        </li>
      ))}
    </ul>

    <NewsletterForm
      id="home"
      title="La lettre"
      text="La suite de la route, par e-mail : les sites, ce qui marche, ce qui rate. Pas de spam, désinscription en un clic."
    />
  </div>
</Base>

<style>
  .home { padding-top: 8px; }
  .who {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }
  .who img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    background: #fff;
    flex-shrink: 0;
  }
  .who b {
    display: block;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .who .tag {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
  }
  .intro {
    margin: 32px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg);
  }
  .actions { margin: 28px 0 0; }
  .k {
    margin: 56px 0 0;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
  }
  .home-list { list-style: none; margin: 0; padding: 0; }
  .home-list li { border-bottom: 1px solid var(--rule); }
  .home-list a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 0;
    color: var(--fg);
    text-decoration: none;
  }
  .home-list .t {
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
  }
  .home-list .d {
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    padding-top: 3px;
  }
  .home :global(.newsletter) { margin-top: 56px; }
  @media (max-width: 600px) {
    .who img { width: 52px; height: 52px; }
    .who b { font-size: 22px; }
    .home-list a { flex-direction: column; gap: 6px; }
  }
</style>
