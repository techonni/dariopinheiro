---
import Base from "../layouts/Base.astro";
import NewsletterForm from "../components/NewsletterForm.astro";

const title = "Dário Pinheiro";
const description = "La lettre — nouveautés par e-mail. Pas de spam, désinscription en un clic.";
---

<Base title={title} description={description} image="/images/pp.jpg">
  <div class="home-mail">
    <img class="home-crown" src="/images/crown.svg" alt="" width="44" height="33" />
    <h1>Dário Pinheiro</h1>
    <p class="tag">La lettre. Pas de spam, désinscription en un clic.</p>
    <NewsletterForm
      id="home"
      title="La lettre"
      text="Les nouveautés par e-mail."
    />
  </div>
</Base>

<style>
  .home-mail {
    max-width: 420px;
    margin: 0 auto;
    padding: 48px 8px 32px;
    text-align: center;
  }
  .home-crown { display: block; margin: 0 auto 14px; opacity: 0.9; }
  h1 {
    margin: 0;
    font-size: 28px;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .tag {
    margin: 10px auto 28px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.45;
  }
  .home-mail :global(.newsletter) { text-align: left; }
  .home-mail :global(.section-title) { text-align: center; }
  .home-mail :global(.nl-text) { text-align: center; }
</style>
