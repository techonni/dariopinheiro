---
import Base from "../layouts/Base.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import PostCard from "../components/PostCard.astro";
import { getJournalPosts, getPosts } from "../lib/blog";

const journal = await getJournalPosts();
const latest = journal.length ? journal.slice(0, 8) : (await getPosts()).slice(0, 8);
const tagline = "Ni développeur, ni designer, ni gourou. J'aime juste créer des trucs sur internet.";
---

<Base title="Dário Pinheiro" description={tagline} image="/images/dario.png" wide>
  <div class="home">
    <div class="home-narrow narrow">
      <div class="who">
        <img src="/images/dario.png" alt="Dario" width="64" height="64" fetchpriority="high" />
        <div>
          <b>Dario</b>
          <p class="tag">{tagline}</p>
        </div>
      </div>

      <p class="intro">
        Ici, je raconte ce que je construis sur internet : sites, pivots, échecs et petites victoires.
        Un article le soir, à la première personne.
      </p>

      <p class="actions">
        <a class="btn" href="/blog/">Lire le blog →</a>
      </p>
    </div>

    <p class="k">Récents</p>
    <div class="card-grid">
      {latest.map((p) => (
        <PostCard post={p} />
      ))}
    </div>

    <div class="home-narrow narrow">
      <NewsletterForm
        id="home"
        title="La lettre"
        text="La suite de la route, par e-mail : les sites, ce qui marche, ce qui rate. Pas de spam, désinscription en un clic."
      />
    </div>
  </div>
</Base>

<style>
  .home { padding-top: 8px; }
  .who {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }
  .who img {
    width: 64px;
    height: 64px;
    object-fit: contain;
    background: #fff;
    flex-shrink: 0;
  }
  .who b {
    display: block;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }
  .who .tag {
    margin: 8px 0 0;
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .intro {
    margin: 32px 0 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--fg);
  }
  .actions { margin: 28px 0 0; }
  .k {
    margin: 56px 0 0;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 16px;
    margin-top: 20px;
    list-style: none;
    padding: 0;
  }
  .home :global(.newsletter) { margin-top: 56px; }
  @media (min-width: 768px) {
    .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; }
  }
  @media (min-width: 1024px) {
    .card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 24px; }
  }
  @media (max-width: 768px) {
    .who img { width: 52px; height: 52px; }
    .who b { font-size: 22px; }
  }
</style>
