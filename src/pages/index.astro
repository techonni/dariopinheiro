---
import Base from "../layouts/Base.astro";

// Work: os sites em que trabalho. Para acrescentar um, copiar uma linha.
const work = [
  { name: "Techonni", text: "Guias de GTA 6 em francês", url: "https://techonni.com" },
  { name: "Zunrel", text: "Guias de Leadpages, HTML Pub e Shopify", url: "https://zunrel.com" },
  { name: "Pieceworth", text: "Guias para comprar luxo com cuidado", url: "https://pieceworth.com" },
];

// Contacto: pôr o link verdadeiro em "url". Os vazios não aparecem.
const links = [
  { name: "E-mail", url: "" },
  { name: "Instagram", url: "" },
  { name: "YouTube", url: "" },
  { name: "LinkedIn", url: "" },
].filter((l) => l.url);

const host = (url: string) => new URL(url).host;
---

<Base title="Dário Pinheiro" description="Dário Pinheiro: os sites em que trabalho.">
  <h1>Dário Pinheiro</h1>
  <p class="lead">Crio sites de guias simples e úteis: Techonni, Zunrel e Pieceworth.</p>
  <p class="lead todo">[a preencher: uma ou duas frases sobre si]</p>

  <section id="work">
    <h2 class="section-title">Work</h2>
    <ul class="list">
      {work.map((w) => (
        <li>
          <a class="item" href={w.url} target="_blank" rel="noopener">
            <span class="item-name">{w.name}</span>
            <span class="item-text">{w.text}</span>
            <span class="item-meta">{host(w.url)} ↗</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="contacto">
    <h2 class="section-title">Contacto</h2>
    {links.length ? (
      <ul class="list">
        {links.map((l) => (
          <li>
            <a class="item" href={l.url} target="_blank" rel="noopener">
              <span class="item-name">{l.name}</span>
              <span class="item-meta">↗</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="lead todo">[a preencher: e-mail e redes sociais]</p>
    )}
  </section>
</Base>
