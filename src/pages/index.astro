---
import Base from "../layouts/Base.astro";

// Os meus sites. Para acrescentar um, copiar um bloco.
// url vazio = falta o link (aparece « a preencher »).
const sites = [
  {
    name: "Techonni",
    url: "https://techonni.com",
    text: "Guias de GTA 6 em francês.",
  },
  {
    name: "Zunrel",
    url: "https://zunrel.com",
    text: "Guias « como fazer » de Leadpages, HTML Pub e Shopify, em francês.",
  },
  {
    name: "Pieceworth",
    url: "",
    text: "",
  },
  {
    name: "Jogo",
    url: "https://game.zunrel.com",
    text: "Um jogo para jogar no navegador.",
  },
];

// Redes e contacto: pôr o link verdadeiro em "url". Os vazios não aparecem.
const links = [
  { name: "E-mail", url: "" },
  { name: "Instagram", url: "" },
  { name: "YouTube", url: "" },
  { name: "LinkedIn", url: "" },
].filter((l) => l.url);

const host = (url: string) => new URL(url).host;
---

<Base title="Dário Pinheiro" description="Dário Pinheiro: os meus sites e projetos na internet.">
  <p class="eyebrow">Olá, eu sou o Dário.</p>
  <h1>Crio sites, guias e jogos na internet.</h1>
  <p class="lead todo">[a preencher: uma ou duas frases sobre quem é e o que faz]</p>

  <section id="sites">
    <h2 class="section-title">Os meus sites</h2>
    <div class="rows">
      {sites.map((s) =>
        s.url ? (
          <a class="row" href={s.url} target="_blank" rel="noopener">
            <span class="row-title">{s.name} →</span>
            <span class="row-text">{s.text}</span>
            <span class="row-meta">{host(s.url)}</span>
          </a>
        ) : (
          <div class="row">
            <span class="row-title">{s.name}</span>
            <span class="row-text todo">[a preencher: link e uma frase]</span>
          </div>
        )
      )}
    </div>
  </section>

  <section id="contacto">
    <h2 class="section-title">Contacto</h2>
    {links.length ? (
      <div class="rows">
        {links.map((l) => (
          <a class="row" href={l.url} target="_blank" rel="noopener">
            <span class="row-title">{l.name} →</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="lead todo">[a preencher: e-mail e redes sociais]</p>
    )}
  </section>
</Base>
