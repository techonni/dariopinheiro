---
import Base from "../layouts/Base.astro";
import NewsletterForm from "../components/NewsletterForm.astro";

// Hub de links (como um « link na bio »). Cada grupo é uma lista de botões.
// Textos do site em francês. Para acrescentar um link, copiar uma linha. Links com url vazio não aparecem.
const groups = [
  {
    title: "Work",
    links: [
      { name: "Techonni", text: "Guides GTA 6 en français", url: "https://techonni.com" },
      { name: "Zunrel", text: "Guides Leadpages, HTML Pub et Shopify", url: "https://zunrel.com" },
      { name: "Pieceworth", text: "Guides pour bien acheter le luxe", url: "https://pieceworth.com" },
    ],
  },
  {
    title: "Jeux",
    links: [{ name: "Jeu", text: "À jouer dans le navigateur", url: "https://game.zunrel.com" }],
  },
  {
    title: "Réseaux",
    links: [
      { name: "X", text: "@zunrel", url: "https://x.com/zunrel" },
    ],
  },
]
  .map((g) => ({ ...g, links: g.links.filter((l) => l.url) }))
  .filter((g) => g.links.length);

const host = (url: string) => (url.startsWith("mailto:") ? url.slice(7) : new URL(url).host);
---

<Base title="Dário Pinheiro" description="Dário Pinheiro : tous mes sites et mes liens au même endroit.">
  <div class="hub">
    <h1>Dário Pinheiro</h1>
    <p class="lead">I make stuff on the internet.</p>

    {groups.map((g) => (
      <section>
        <h2 class="section-title">{g.title}</h2>
        <ul class="buttons">
          {g.links.map((l) => (
            <li>
              <a class="button" href={l.url} target="_blank" rel="noopener">
                <span>
                  <span class="button-name">{l.name}</span>
                  {l.text && <span class="button-text">{l.text}</span>}
                </span>
                <span class="button-meta">{host(l.url)} ↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <NewsletterForm />
  </div>
</Base>
