---
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { formatDateShort, getGuidePosts, getJournalPosts, readingMinutes } from "../../lib/blog";

const journal = await getJournalPosts();
const guides = await getGuidePosts();

const site = Astro.site!;
const title = "Blog · Dário Pinheiro";
const description = "Journal personnel et guides : ce que je construis, ce qui marche, ce qui rate.";

const allListed = [...journal, ...guides];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog de Dário Pinheiro",
  url: new URL("/blog/", site).href,
  inLanguage: "fr",
  description,
  author: { "@type": "Person", name: "Dário Pinheiro", url: site.href },
  blogPost: allListed.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, site).href,
    datePublished: p.data.published.toISOString(),
    dateModified: p.data.updated.toISOString(),
  })),
};
---

<Base title={title} description={description} image="/images/dario.png" wide>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="blog">
    <header class="blog-head">
      <p class="eyebrow-plain">Blog</p>
      <h1>Le journal.</h1>
      <p class="lead">
        Ce que j&apos;ai fait ces derniers mois — sites, pivots, échecs et victoires — puis les guides tirés de la route.
      </p>
    </header>

    {journal.length > 0 && (
      <section class="blog-section">
        <h2 class="section-title">Journal</h2>
        <ul class="post-list">
          {journal.map((p) => (
            <li>
              <a class="post-row" href={`/blog/${p.id}/`}>
                <span class="post-title">{p.data.title}</span>
                <span class="post-meta">{formatDateShort(p.data.published)} · {readingMinutes(p)} min →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {guides.length > 0 && (
      <section class="blog-section">
        <h2 class="section-title">Guides</h2>
        <ul class="post-list">
          {guides.map((p) => (
            <li>
              <a class="post-row" href={`/blog/${p.id}/`}>
                <span class="post-title">{p.data.title}</span>
                <span class="post-meta">{readingMinutes(p)} min →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <NewsletterForm
      title="La lettre"
      text="La suite de la route, par e-mail : les sites, ce qui marche, ce qui rate. Pas de spam, désinscription en un clic."
    />
  </div>
</Base>

<style>
  .blog-head { padding-top: 8px; }
  .blog-head h1 {
    margin-top: 8px;
    font-size: 40px;
    letter-spacing: -0.03em;
  }
  .blog-section { margin-top: 56px; }
  .section-title {
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
  }
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-list li { border-bottom: 1px solid var(--rule); }
  .post-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding: 22px 0;
    color: var(--fg);
    text-decoration: none;
  }
  .post-title {
    flex: 1 1 auto;
    min-width: 0;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.35;
    overflow-wrap: anywhere;
    word-break: break-word;
    white-space: normal;
  }
  .post-meta {
    flex: 0 0 auto;
    font-size: 13px;
    color: var(--muted);
    white-space: nowrap;
    padding-top: 3px;
  }
  @media (max-width: 768px) {
    .blog-head h1 { font-size: 32px; overflow-wrap: anywhere; }
    .post-row { flex-direction: column; gap: 6px; }
    .post-meta { white-space: normal; }
  }

</style>
