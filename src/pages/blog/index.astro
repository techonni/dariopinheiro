---
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import PostCard from "../../components/PostCard.astro";
import { getGuidePosts, getJournalPosts } from "../../lib/blog";

const journal = await getJournalPosts();
const guides = await getGuidePosts();

const site = Astro.site!;
const title = "Blog · Dário Pinheiro";
const description = "Journal personnel et guides : ce que je construis, ce qui marche, ce qui rate.";

const allListed = [...journal, ...guides];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog de Dário Pinheiro",
  url: new URL("/blog/", site).href,
  inLanguage: "fr",
  description,
  author: { "@type": "Person", name: "Dário Pinheiro", url: site.href },
  blogPost: allListed.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, site).href,
    datePublished: p.data.published.toISOString(),
    dateModified: p.data.updated.toISOString(),
  })),
};
---

<Base title={title} description={description} image="/images/dario.png">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="blog">
    <header class="blog-head blog-narrow narrow">
      <p class="eyebrow-plain">Blog</p>
      <h1>Le journal.</h1>
      <p class="lead">
        Ce que j&apos;ai fait ces derniers mois — sites, pivots, échecs et victoires — puis les guides tirés de la route.
      </p>
    </header>

    {journal.length > 0 && (
      <section class="blog-section">
        <h2 class="section-title">Journal</h2>
        <div class="card-grid">
          {journal.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )}

    {guides.length > 0 && (
      <section class="blog-section">
        <h2 class="section-title">Guides</h2>
        <div class="card-grid">
          {guides.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )}

    <div class="blog-narrow narrow">
      <NewsletterForm
        title="La lettre"
        text="La suite de la route, par e-mail : les sites, ce qui marche, ce qui rate. Pas de spam, désinscription en un clic."
      />
    </div>
  </div>
</Base>

<style>
  .blog { max-width: 520px; margin: 0 auto; }
  .blog-head { padding-top: 24px; text-align: center; }
  .blog-head h1 { margin: 6px 0 0; font-size: 30px; font-weight: 500; letter-spacing: -.04em; }
  .blog-head .lead { margin: 10px auto 0; max-width: 400px; font-size: 16px; line-height: 1.5; }
  .blog-section { margin-top: 44px; }
  .section-title {
    margin: 0 0 14px; padding: 0; border: 0; text-align: center;
    font-size: 11px; letter-spacing: .14em; text-transform: uppercase; font-weight: 400; color: #8a8a85;
  }
  .card-grid { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 0; }
</style>
