---
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import PostCard from "../../components/PostCard.astro";
import { getGuidePosts, getJournalPosts } from "../../lib/blog";

const journal = await getJournalPosts();
const guides = await getGuidePosts();

const site = Astro.site!;
const title = "Blog · Dário Pinheiro";
const description = "Journal personnel et guides : ce que je construis, ce qui marche, ce qui rate.";

const allListed = [...journal, ...guides];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog de Dário Pinheiro",
  url: new URL("/blog/", site).href,
  inLanguage: "fr",
  description,
  author: { "@type": "Person", name: "Dário Pinheiro", url: site.href },
  blogPost: allListed.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, site).href,
    datePublished: p.data.published.toISOString(),
    dateModified: p.data.updated.toISOString(),
  })),
};
---

<Base title={title} description={description} image="/images/dario.png" wide>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="blog">
    <header class="blog-head blog-narrow narrow">
      <p class="eyebrow-plain">Blog</p>
      <h1>Le journal.</h1>
      <p class="lead">
        Ce que j&apos;ai fait ces derniers mois — sites, pivots, échecs et victoires — puis les guides tirés de la route.
      </p>
    </header>

    {journal.length > 0 && (
      <section class="blog-section">
        <h2 class="section-title">Journal</h2>
        <div class="card-grid">
          {journal.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )}

    {guides.length > 0 && (
      <section class="blog-section">
        <h2 class="section-title">Guides</h2>
        <div class="card-grid">
          {guides.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )}

    <div class="blog-narrow narrow">
      <NewsletterForm
        title="La lettre"
        text="La suite de la route, par e-mail : les sites, ce qui marche, ce qui rate. Pas de spam, désinscription en un clic."
      />
    </div>
  </div>
</Base>

<style>
  .blog-head { padding-top: 8px; }
  .blog-head h1 {
    margin-top: 8px;
    font-size: 40px;
    letter-spacing: -0.03em;
  }
  .blog-section { margin-top: 56px; }
  .section-title {
    margin: 0;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--rule);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 16px;
    margin-top: 20px;
  }
  @media (min-width: 768px) {
    .card-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px 20px; }
  }
  @media (min-width: 1024px) {
    .card-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 24px; }
  }
  @media (max-width: 768px) {
    .blog-head h1 { font-size: 32px; overflow-wrap: anywhere; }
  }
</style>
