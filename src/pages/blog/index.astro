---
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { categories, getPosts, readingMinutes } from "../../lib/blog";

const posts = await getPosts();
const sections = categories
  .map((name) => ({ name, posts: posts.filter((p) => p.data.category === name) }))
  .filter((s) => s.posts.length);

const site = Astro.site!;
const title = "Blog · La route, en guides · Dário Pinheiro";
const description =
  "La route pour faire des sites, étape par étape, à partir de ce que je construis. Zunrel est le site public. Le reste renvoie ici.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Blog de Dário Pinheiro",
  url: new URL("/blog/", site).href,
  inLanguage: "fr",
  description,
  author: { "@type": "Person", name: "Dário Pinheiro", url: site.href },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, site).href,
    datePublished: p.data.published.toISOString(),
    dateModified: p.data.updated.toISOString(),
  })),
};
---

<Base title={title} description={description} image="/images/dario.jpg" wide>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="blog">
    <header class="blog-head">
      <p class="eyebrow-plain">Blog</p>
      <h1>La route, en guides.</h1>
      <p class="lead">
        {posts.length} guides, étape par étape, tirés de ce que je construis.{" "}
        <a class="inline-link" href="https://zunrel.com" target="_blank" rel="noopener">Zunrel</a>{" "}
        est le site public. techonni.com et pieceworth.com renvoient ici.
      </p>
    </header>

    {sections.map((s) => (
      <section class="blog-section">
        <h2 class="section-title">{s.name}</h2>
        <ul class="post-list">
          {s.posts.map((p) => (
            <li>
              <a class="post-card" href={`/blog/${p.id}/`}>
                <span class="post-title">{p.data.title}</span>
                <span class="post-summary">{p.data.summary}</span>
                <span class="post-meta">{readingMinutes(p)} min de lecture</span>
                <span class="arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <NewsletterForm
      title="La lettre"
      text="La suite de la route, par e-mail : les sites, ce qui marche, ce qui rate. Pas de spam, désinscription en un clic."
    />
  </div>
</Base>
