---
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { getPosts, formatDate, readingMinutes } from "../../lib/blog";

const posts = await getPosts();
const site = Astro.site!;
const title = "Blog · Phobie sociale · Dário Pinheiro";
const description =
  "Une série gratuite en français sur la phobie sociale (trouble d'anxiété sociale), à lire comme un livre, du chapitre 001 au dernier.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Blog",
  name: "Phobie sociale — série gratuite",
  url: new URL("/blog/", site).href,
  inLanguage: "fr",
  description,
  author: { "@type": "Person", name: "Dário Pinheiro", url: site.href },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    url: new URL(`/blog/${p.id}/`, site).href,
    datePublished: p.data.published.toISOString(),
    dateModified: p.data.updated.toISOString(),
  })),
};
---

<Base title={title} description={description} image="/images/pp.jpg">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <div class="blog">
    <header class="blog-head blog-narrow narrow">
      <h1>Phobie sociale</h1>
      <p class="lead">
        Une série gratuite à lire dans l'ordre, comme un livre. Critères, modèles, exercices de TCC et ressources — sans remplacer un professionnel de santé.
      </p>
      <p class="disclaimer">
        Ceci n'est <strong>pas un avis médical</strong>. Si tu souffres, parle à un médecin, un psychologue ou un service d'urgence. En France : 3114 (prévention du suicide). Au Portugal : SNS 24 — 808 24 24 24.
      </p>
    </header>

    <section class="blog-section">
      <ol class="toc">
        {posts.map((p, i) => (
          <li>
            <a class="toc-row" href={`/blog/${p.id}/`}>
              <span class="toc-num">{String(i + 1).padStart(3, "0")}</span>
              <span class="toc-body">
                <span class="toc-title">{p.data.title.replace(/^Article \d+ — /, "")}</span>
                <span class="toc-meta">{readingMinutes(p)} min · {formatDate(p.data.published)}</span>
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    <div class="blog-narrow narrow">
      <NewsletterForm
        title="La lettre"
        text="La suite de la série et d'autres notes, par e-mail. Pas de spam, désinscription en un clic."
      />
    </div>
  </div>
</Base>

<style>
  .blog { padding-bottom: 24px; }
  .blog-head { margin-bottom: 8px; }
  .disclaimer {
    margin: 18px 0 0; padding: 12px 14px; border-radius: 12px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08);
    font-size: 13px; line-height: 1.45; color: var(--muted);
  }
  .toc { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 8px; }
  .toc-row {
    display: flex; gap: 14px; align-items: flex-start;
    padding: 14px; border-radius: 16px; text-decoration: none; color: inherit;
    background: linear-gradient(180deg, rgba(255,255,255,.055), rgba(255,255,255,.025));
    border: 1px solid rgba(255,255,255,.07);
  }
  .toc-row:hover { border-color: rgba(207,227,226,.35); }
  .toc-num {
    flex: none; width: 42px; height: 42px; border-radius: 12px;
    display: grid; place-items: center;
    background: rgba(207,227,226,.12); color: #cfe3e2;
    font-size: 13px; font-weight: 600; letter-spacing: .02em;
  }
  .toc-body { min-width: 0; display: grid; gap: 4px; }
  .toc-title { font-size: 16px; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; }
  .toc-meta { font-size: 12px; color: var(--muted); }
</style>
