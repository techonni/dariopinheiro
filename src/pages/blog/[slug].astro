---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import { formatDate, getAllPosts, getPosts, readingMinutes, splitForNewsletter, type Post } from "../../lib/blog";

export async function getStaticPaths() {
  const all = await getAllPosts();
  const posts = await getPosts();
  return all.map((post) => {
    const i = posts.findIndex((p) => p.id === post.id);
    return {
      params: { slug: post.id },
      props: {
        post,
        prev: i > 0 ? posts[i - 1] : null,
        next: i >= 0 && i < posts.length - 1 ? posts[i + 1] : null,
        more: posts.filter((p) => p.id !== post.id).slice(0, 3),
      },
    };
  });
}

interface Props {
  post: Post;
  prev: Post | null;
  next: Post | null;
  more: Post[];
}

const { post, prev, next, more } = Astro.props;
const { Content } = await render(post);
const parts = post.rendered?.html ? splitForNewsletter(post.rendered.html) : null;
const site = Astro.site!;
const url = new URL(`/blog/${post.id}/`, site).href;
const minutes = readingMinutes(post);
const shareUrl = `https://x.com/intent/post?${new URLSearchParams({ text: post.data.title, url, via: "yote0zte" }).toString().replace(/\+/g, "%20")}`;
const seoBase = post.data.seoTitle ?? post.data.title;
const title = seoBase.length + 17 <= 65 ? `${seoBase} · Dário Pinheiro` : seoBase;
const letter = "La suite du récit, par e-mail. Pas de spam, désinscription en un clic.";
const ogImage = post.data.images?.[0]?.url ?? "/apple-touch-icon.png";

const author = { "@type": "Person", name: "Dário Pinheiro", url: site.href };
const article = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  image: post.data.images?.map((i) => i.url) ?? [new URL("/images/pp.jpg", site).href],
  datePublished: post.data.published.toISOString(),
  dateModified: post.data.updated.toISOString(),
  inLanguage: "fr",
  author,
  publisher: author,
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  articleSection: post.data.category,
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Accueil", item: site.href },
    { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", site).href },
    { "@type": "ListItem", position: 3, name: post.data.title, item: url },
  ],
};
---

<Base title={title} description={post.data.description} ogType="article" image={ogImage.startsWith("http") ? undefined : ogImage} wide>
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.published.toISOString()} />
    <meta property="article:modified_time" content={post.data.updated.toISOString()} />
    <meta property="article:section" content={post.data.category} />
    {ogImage.startsWith("http") && <meta property="og:image" content={ogImage} />}
    <script type="application/ld+json" set:html={JSON.stringify(article)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
  </Fragment>

  <article class="post">
    <p class="back"><a href="/blog/">← Blog</a></p>
    <p class="eyebrow-plain">Blog</p>
    <h1>{post.data.title}</h1>
    <p class="post-byline">
      <time datetime={post.data.published.toISOString().slice(0, 10)}>{formatDate(post.data.published)}</time>
      {" · "}Dario{" · "}{minutes} min
    </p>
    {post.data.updated.getTime() !== post.data.published.getTime() && (
      <p class="post-updated">Mis à jour le {formatDate(post.data.updated)}</p>
    )}

    {parts ? (
      <>
        <div class="prose" set:html={parts[0]} />
        <NewsletterForm id="mid" variant="inline" title="La lettre" text={letter} />
        <div class="prose prose-after" set:html={parts[1]} />
      </>
    ) : (
      <div class="prose">
        <Content />
      </div>
    )}

    <p class="post-share">
      <a class="btn" href={shareUrl} target="_blank" rel="noopener">Partager sur X →</a>
    </p>
  </article>

  <NewsletterForm id="end" title="La lettre" text={letter} />

  {(prev || next) && (
    <nav class="chapnav" aria-label="Chapitres">
    {prev && (
      <a class="chapnav-link" href={`/blog/${prev.id}/`}>
        <span class="chapnav-label">← Précédent</span>
        <span class="chapnav-title">{prev.data.title}</span>
      </a>
    )}
    {next && (
      <a class="chapnav-link chapnav-next" href={`/blog/${next.id}/`}>
        <span class="chapnav-label">Suivant →</span>
        <span class="chapnav-title">{next.data.title}</span>
      </a>
    )}
  </nav>

  <section class="next">
    <h2 class="section-title">Sommaire</h2>
    <p class="next-note"><a href="/blog/">Voir toute la série →</a></p>
    <ul class="next-list">
      {more.map((p) => (
        <li>
          <a href={`/blog/${p.id}/`}>
            <span>{p.data.title}</span>
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  )}
</Base>

<style>
  .back { margin: 0 0 24px; font-size: 14px; }
  .back a { color: var(--muted); text-decoration: none; }
  .back a:hover { color: var(--fg); }
  .post h1 {
    margin: 8px 0 0;
    font-size: 36px;
    line-height: 1.2;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .post-byline {
    margin: 16px 0 0;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--rule);
    font-size: 13px;
    color: var(--muted);
  }
  .post-updated { margin: 8px 0 0; font-size: 13px; color: var(--muted); }
  .post-share { margin-top: 40px; }
  .next { margin-top: 64px; }
  .section-title {
    margin: 0;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--rule);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
  }
  .next-list { list-style: none; margin: 0; padding: 0; }
  .next-list li { border-bottom: 1px solid var(--rule); }
  .next-list a {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 0;
    color: var(--fg);
    text-decoration: none;
    font-weight: 600;
  }
  .next-list a > span:first-child {
    flex: 1 1 auto;
    min-width: 0;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .next-list .arrow { flex: 0 0 auto; color: var(--muted); font-weight: 400; }
  .all-posts { margin-top: 28px; }
  @media (max-width: 600px) {
    .post h1 { font-size: 28px; }
  }

  .chapnav { display: grid; gap: 10px; margin: 48px 0 24px; }
  @media (min-width: 640px) { .chapnav { grid-template-columns: 1fr 1fr; } }
  .chapnav-link {
    display: grid; gap: 4px; padding: 14px; border-radius: 14px; text-decoration: none; color: inherit;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08);
  }
  .chapnav-next { text-align: right; }
  .chapnav-label { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; }
  .chapnav-title { font-size: 15px; font-weight: 500; line-height: 1.35; }
  .next-note { margin: 0 0 12px; font-size: 14px; }
</style>
