---
// Newsletter: a mesma interface do zunrel.com (formulário « embedded » do Mailchimp,
// envio em segundo plano pelo ponto JSONP « post-json », confirmação por e-mail).
// Sem chave API nem servidor. Usa a MESMA audiência Mailchimp do zunrel.com
// (lista 893c08eb5d): o link e o campo anti-robots são os de src/lib/guides.ts do zunrel.
// Componente reutilizável: pode aparecer várias vezes na mesma página (meio e fim de cada guia).
// - text: frase de introdução (opcional).
// - title: título do bloco (por defeito « Newsletter »).
// - id: sufixo único quando há vários formulários na página (ids do campo e da iframe).
// - variant: "section" (bloco normal, título h2) ou "inline" (no meio de um guia: traços finos
//   em cima e em baixo, título que não entra no plano do artigo, e desaparece se o visitante já se inscreveu).
interface Props {
  text?: string;
  title?: string;
  id?: string;
  variant?: "section" | "inline";
}
const {
  text = "Les nouveautés de mes sites par e-mail. Pas de spam, désinscription en un clic.",
  title = "Newsletter",
  id = "main",
  variant = "section",
} = Astro.props;
const emailId = `newsletter-email-${id}`;
const helpId = `newsletter-help-${id}`;
const frameName = `dp-newsletter-frame-${id}`;
const Wrapper = variant === "inline" ? "aside" : "section";

const formUrl =
  "https://gmail.us9.list-manage.com/subscribe/post?u=13aa96838d6074fef23022e3e&id=893c08eb5d&f_id=0073d9e1f0";
const honeypot = "b_13aa96838d6074fef23022e3e_893c08eb5d";

// TODO (tag do hub): ainda NÃO existe no Mailchimp uma tag para as inscrições vindas
// de dariopinheiro.com. Tags existentes na audiência (zunrel): shopify 11404677,
// leadpages 11404678, htmlpub 11404679, lang-fr 11404680, lang-pt 11404681, lang-en 11404682.
// Para identificar o hub: criar a tag (ex.: « hub ») em Mailchimp → Audience → Tags,
// copiar o seu ID numérico e pô-lo aqui (vários IDs separados por vírgula, ex.: "<id>,11404680").
// Enquanto estiver vazio, o campo `tags` não é enviado.
const hubTagIds = "11404686";

const messages = {
  send: "Envoi…",
  button: "S'inscrire",
  thanks: "Merci !",
  confirm: "Dernière étape : ouvrez l'e-mail envoyé à {email} et cliquez sur le bouton pour confirmer.",
  already: "Vous êtes déjà inscrit.",
  alreadyText: "Merci ! Les prochaines nouveautés arrivent dans votre boîte mail.",
  invalid: "Entrez une adresse e-mail valide, par exemple vous@exemple.com.",
  tooMany: "Trop de tentatives avec cette adresse. Réessayez dans quelques minutes.",
  failed: "Cette adresse n'a pas pu être inscrite. Vérifiez-la et réessayez.",
};
---

<Wrapper
  data-newsletter-block
  data-variant={variant}
  data-messages={JSON.stringify(messages)}
  class:list={["newsletter", variant === "inline" && "newsletter-inline"]}
  aria-label={variant === "inline" ? title : undefined}
>
  <div data-newsletter-intro>
    {variant === "inline" ? <p class="section-title">{title}</p> : <h2 class="section-title">{title}</h2>}
    <p class="nl-text">{text}</p>
    <form action={formUrl || undefined} method="post" target={frameName} novalidate data-newsletter={formUrl ? "" : undefined} class="nl-form">
      <label for={emailId} class="sr-only">E-mail</label>
      <input
        id={emailId}
        type="email"
        name="EMAIL"
        required
        autocomplete="email"
        inputmode="email"
        placeholder="ton@email.com"
        aria-describedby={helpId}
        class="nl-input"
      />
      {hubTagIds && <input type="hidden" name="tags" value={hubTagIds} />}
      {honeypot && (
        <div aria-hidden="true" style="position: absolute; left: -5000px;">
          <input type="text" name={honeypot} tabindex="-1" value="" />
        </div>
      )}
      <button type="submit" class="nl-button" disabled={!formUrl}>
        <span data-newsletter-spinner hidden class="newsletter-spinner" aria-hidden="true"></span>
        <span data-newsletter-label>{messages.button}</span>
      </button>
    </form>
    <p id={helpId} data-newsletter-message aria-live="polite" class="nl-help" hidden={!formUrl}>
      {formUrl ? "Vous recevrez un e-mail pour confirmer votre inscription." : ""}
    </p>
  </div>

  <div data-newsletter-done hidden tabindex="-1" class="newsletter-done">
    <span class="nl-check" aria-hidden="true">
      <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
        <path class="newsletter-check" d="M2.5 6.2 5 8.5l4.5-5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </span>
    <div>
      <p data-newsletter-done-title class="nl-done-title">{messages.thanks}</p>
      <p data-newsletter-done-text class="nl-done-text"></p>
    </div>
  </div>

  <iframe name={frameName} title="Inscription à la newsletter" hidden tabindex="-1"></iframe>
</Wrapper>

<style>
  /* Sem caixa à volta (estilo minimalista): só o título, o texto e o formulário. */
  .newsletter { margin-top: 56px; text-align: left; }
  .newsletter .section-title { margin-left: 0; }
  /* No meio de um guia: só dois traços finos, sem caixa nem fundo. */
  .newsletter-inline { margin: 48px 0 0; padding: 28px 0 32px; border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .newsletter-inline[data-hidden] { display: none; }
  .newsletter.is-done { display: flex; flex-direction: column; justify-content: center; }
  .nl-title { margin: 0; font-size: 15px; line-height: 20px; font-weight: 500; color: var(--fg); }
  .nl-text { margin: 12px 0 0; font-size: 15px; line-height: 24px; color: var(--text); }
  .nl-form {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 10px;
    width: 100%;
  }
  .nl-input {
    flex: 1 1 auto;
    height: 48px;
    width: 100%;
    min-width: 0;
    padding: 0 16px;
    border: 1px solid #111;
    border-radius: 6px;
    background: #fff;
    font: inherit;
    font-size: 16px;
    color: var(--fg);
    outline: none;
  }
  .nl-input::placeholder { color: #666; opacity: 1; }
  .nl-input:focus { border-color: #111; box-shadow: 0 0 0 1px #111; }
  .nl-input[aria-invalid="true"] { border-color: var(--id-danger); box-shadow: 0 0 0 1px var(--id-danger); }
  .nl-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: 0 0 auto;
    height: 48px;
    width: 100%;
    min-width: 120px;
    padding: 0 22px;
    border: 0;
    border-radius: 9999px;
    background: #111;
    color: #fff;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.15s;
    white-space: nowrap;
  }
  .nl-button:hover { background: #333; }
  .nl-button:disabled { background: var(--id-surface-3); color: var(--id-text-2); cursor: not-allowed; }
  .nl-help[hidden] { display: none; }
  .nl-help { margin: 12px 0 0; font-size: 13px; line-height: 20px; color: var(--faint); }
  .newsletter-done { display: flex; align-items: flex-start; gap: 12px; outline: none; }
  .newsletter-done[hidden] { display: none; }
  .nl-check { margin-top: 2px; display: flex; width: 24px; height: 24px; flex-shrink: 0; align-items: center; justify-content: center; border-radius: 9999px; background: var(--id-success); }
  .nl-done-title { margin: 0; font-size: 15px; line-height: 24px; font-weight: 500; color: var(--fg); }
  .nl-done-text { margin: 4px 0 0; font-size: 14px; line-height: 24px; color: var(--text); }
  @media (min-width: 480px) {
    .nl-form { flex-direction: row; align-items: center; }
    .nl-input { flex: 1 1 auto; width: auto; }
    .nl-button { width: auto; flex: 0 0 auto; }
  }
  .newsletter-spinner {
    width: 14px;
    height: 14px;
    border-radius: 9999px;
    border: 2px solid rgb(0 0 0 / 0.25);
    border-top-color: #000;
    animation: newsletter-spin 0.7s linear infinite;
  }
  .newsletter-done:not([hidden]) {
    animation: newsletter-in 0.35s ease-out both;
  }
  .newsletter-done:not([hidden]) .newsletter-check {
    stroke-dasharray: 12;
    stroke-dashoffset: 12;
    animation: newsletter-draw 0.4s 0.15s ease-out forwards;
  }
  @keyframes newsletter-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes newsletter-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  @keyframes newsletter-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .newsletter-spinner,
    .newsletter-done:not([hidden]),
    .newsletter-done:not([hidden]) .newsletter-check {
      animation: none;
      stroke-dashoffset: 0;
    }
  }
</style>

<script is:inline>
  // Vários formulários por página: cada bloco tem o seu estado; quando um se inscreve, os outros
  // passam a « déjà inscrit » (e os do meio do guia desaparecem).
  // O script repete-se em cada bloco: só o primeiro corre, depois de a página toda estar lida.
  (function () {
    if (window.__dpNewsletterInit) return;
    window.__dpNewsletterInit = true;
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init);
    else init();
    function init() {
    var storageKey = "dp-newsletter";
    var blocks = Array.prototype.slice.call(document.querySelectorAll("[data-newsletter-block]"));
    var others = [];
    blocks.forEach(function (block) {
    var form = block.querySelector("form[data-newsletter]");
    if (!form) return;
    var inline = block.getAttribute("data-variant") === "inline";
    var intro = block.querySelector("[data-newsletter-intro]");
    var done = block.querySelector("[data-newsletter-done]");
    var doneTitle = block.querySelector("[data-newsletter-done-title]");
    var doneText = block.querySelector("[data-newsletter-done-text]");
    var message = block.querySelector("[data-newsletter-message]");
    var input = form.querySelector('input[name="EMAIL"]');
    var button = form.querySelector('button[type="submit"]');
    var spinner = button.querySelector("[data-newsletter-spinner]");
    var label = button.querySelector("[data-newsletter-label]");
    var defaultHelp = message.textContent;
    var m = JSON.parse(block.getAttribute("data-messages") || "{}");

    function remember() {
      try {
        localStorage.setItem(storageKey, "1");
      } catch (e) {}
      others.forEach(function (o) {
        if (o.block !== block) o.already();
      });
    }

    function setBusy(busy) {
      button.disabled = busy;
      spinner.hidden = !busy;
      label.textContent = busy ? m.send : m.button;
      input.readOnly = busy;
    }

    function setError(text) {
      input.setAttribute("aria-invalid", "true");
      message.textContent = text;
      message.style.color = "#ff6961";
      input.focus();
    }

    function clearError() {
      input.removeAttribute("aria-invalid");
      message.textContent = defaultHelp;
      message.style.color = "";
    }

    function showDone(title, text, moveFocus) {
      doneTitle.textContent = title;
      doneText.textContent = text;
      // Garde la hauteur du bloc pour que la page ne saute pas, et centre le message.
      if (moveFocus !== false) block.style.minHeight = block.offsetHeight + "px";
      block.classList.add("is-done");
      intro.hidden = true;
      done.hidden = false;
      if (moveFocus !== false) done.focus({ preventScroll: true });
    }

    // Déjà inscrit : un simple rappel au lieu du formulaire (au milieu d'un guide, rien du tout).
    function already() {
      if (inline) block.setAttribute("data-hidden", "");
      else showDone(m.already, m.alreadyText, false);
    }
    others.push({ block: block, already: already });
    try {
      if (localStorage.getItem(storageKey) === "1") already();
    } catch (e) {}

    input.addEventListener("input", function () {
      if (input.hasAttribute("aria-invalid")) clearError();
    });

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      if (!input.value.trim() || !input.checkValidity()) {
        // Pas d'envoi : l'événement ne compte pas comme inscription dans les statistiques.
        event.stopPropagation();
        setError(m.invalid);
        return;
      }

      var email = input.value.trim();
      var name = "dpNewsletter" + Date.now();
      var url = form.action.replace("/subscribe/post?", "/subscribe/post-json?");
      var params = new URLSearchParams(new FormData(form));
      params.set("c", name);
      var script = document.createElement("script");
      var finished = false;

      function finish() {
        finished = true;
        clearTimeout(fallback);
        setBusy(false);
        delete window[name];
        script.remove();
      }

      function success() {
        remember();
        showDone(m.thanks, m.confirm.replace("{email}", email));
      }

      // Mailchimp ne répond pas : envoi classique dans l'iframe cachée, sans quitter la page.
      function sendInFrame() {
        if (finished) return;
        finish();
        form.submit();
        success();
      }

      var fallback = setTimeout(sendInFrame, 8000);

      window[name] = function (data) {
        if (finished) return;
        finish();
        var msg = (data && data.msg) || "";
        if (data && data.result === "success") {
          success();
        } else if (/already subscribed|déjà inscrit/i.test(msg)) {
          remember();
          showDone(m.already, m.alreadyText);
        } else if (/too many|trop de/i.test(msg)) {
          setError(m.tooMany);
        } else {
          setError(m.failed);
        }
      };

      clearError();
      setBusy(true);
      script.src = url + "&" + params.toString();
      script.onerror = sendInFrame;
      document.body.appendChild(script);
    });
      });
    }
  })();
</script>
