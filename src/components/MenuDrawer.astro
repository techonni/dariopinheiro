---
// Menu lateral (hambúrguer), igual ao do techonni.com / zunrel.com / pieceworth.com:
// painel escuro a toda a altura que desliza da direita, fundo escurecido,
// fecha com ✕, Esc, clique fora ou clique num link.
import { host, menuGroups } from "../lib/links";
---

<button
  type="button"
  class="menu-button"
  aria-expanded="false"
  aria-controls="site-menu"
  aria-label="Menu"
  data-menu-button
>
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
    <path d="M2.5 4.5h13M2.5 9h13M2.5 13.5h13" />
  </svg>
</button>

<div id="site-menu" class="menu-drawer" hidden data-menu-drawer>
  <div class="menu-backdrop" aria-hidden="true" data-menu-backdrop></div>
  <div class="menu-panel" role="dialog" aria-modal="true" aria-label="Menu" data-menu-panel>
    <div class="menu-top">
      <button type="button" class="menu-button" aria-label="Fermer le menu" data-menu-close>
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 4l10 10M14 4L4 14" />
        </svg>
      </button>
    </div>

    <p class="menu-label">Blog</p>
    <nav class="menu-list" aria-label="Blog">
      <a href="/blog/">
        <span class="menu-name">Tous les guides</span>
        <span class="menu-meta">dariopinheiro.com/blog</span>
      </a>
    </nav>

    {menuGroups.map((g) => (
      <>
        <p class="menu-label">{g.title}</p>
        <nav class="menu-list" aria-label={g.title}>
          {g.links.map((l) => (
            <a href={l.url} target="_blank" rel="noopener">
              <span class="menu-name">{l.name}</span>
              {l.text && <span class="menu-text">{l.text}</span>}
              <span class="menu-meta">{host(l.url)} ↗</span>
            </a>
          ))}
        </nav>
      </>
    ))}
  </div>
</div>

<script>
  // Menu lateral: o botão abre; ✕, Esc, clique no fundo e clique num link fecham.
  // O foco entra no menu (e fica lá) e volta ao botão; a página não rola enquanto está aberto.
  const button = document.querySelector<HTMLButtonElement>("[data-menu-button]");
  const drawer = document.querySelector<HTMLElement>("[data-menu-drawer]");
  if (button && drawer) {
    const panel = drawer.querySelector<HTMLElement>("[data-menu-panel]")!;
    const closeButton = drawer.querySelector<HTMLButtonElement>("[data-menu-close]")!;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let hideTimer: number | undefined;
    const isOpen = () => button.getAttribute("aria-expanded") === "true";
    const lockScroll = (lock: boolean) => {
      const root = document.documentElement;
      if (lock) {
        const scrollbar = window.innerWidth - root.clientWidth;
        root.style.overflow = "hidden";
        if (scrollbar > 0) document.body.style.paddingRight = `${scrollbar}px`;
      } else {
        root.style.overflow = "";
        document.body.style.paddingRight = "";
      }
    };
    const open = () => {
      window.clearTimeout(hideTimer);
      drawer.hidden = false;
      lockScroll(true);
      void drawer.offsetWidth; // a animação parte da posição fechada
      drawer.setAttribute("data-open", "");
      button.setAttribute("aria-expanded", "true");
      closeButton.focus({ preventScroll: true });
    };
    const close = () => {
      if (!isOpen()) return;
      drawer.removeAttribute("data-open");
      button.setAttribute("aria-expanded", "false");
      lockScroll(false);
      button.focus({ preventScroll: true });
      hideTimer = window.setTimeout(() => (drawer.hidden = true), reducedMotion.matches ? 0 : 300);
    };
    button.addEventListener("click", () => (isOpen() ? close() : open()));
    closeButton.addEventListener("click", close);
    drawer.querySelector("[data-menu-backdrop]")!.addEventListener("click", close);
    panel.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) close();
    });
    document.addEventListener("keydown", (event) => {
      if (!isOpen()) return;
      if (event.key === "Escape") {
        event.preventDefault();
        close();
      } else if (event.key === "Tab") {
        const items = [...panel.querySelectorAll<HTMLElement>("a[href], button")];
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && (document.activeElement === first || !panel.contains(document.activeElement))) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && (document.activeElement === last || !panel.contains(document.activeElement))) {
          event.preventDefault();
          first.focus();
        }
      }
    });
  }
</script>
