---
import type { Post } from "../lib/blog";
import { getCardImage, getExcerpt } from "../lib/blog";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const img = getCardImage(post);
const excerpt = getExcerpt(post);
---

<a class="post-card" href={`/blog/${post.id}/`}>
  <div class="post-card-media">
    <img src={img.url} alt={img.alt} loading="lazy" decoding="async" width="800" height="500" />
  </div>
  <div class="post-card-body">
    <h3 class="post-card-title">{post.data.title}</h3>
    {excerpt && <p class="post-card-excerpt">{excerpt}</p>}
    <span class="post-card-arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: row;
    gap: 14px;
    align-items: center;
    height: auto;
    padding: 10px;
    color: var(--fg);
    text-decoration: none;
    background: #fbfbfa;
    border-radius: 18px;
    box-shadow: 0 1px 2px rgba(0,0,0,.04), 0 6px 20px rgba(0,0,0,.03);
    transition: transform .2s cubic-bezier(.23,1,.32,1);
    min-width: 0;
  }
  .post-card:active { transform: scale(.98); }
  @media (hover: hover) and (pointer: fine) { .post-card:hover { transform: translateY(-2px); } }
  .post-card-media { width: 120px; height: 96px; flex: none; overflow: hidden; border-radius: 12px; background: #f0f0f0; }
  .post-card-media img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .post-card-body { display: block; padding: 0; min-width: 0; }
  .post-card-title { margin: 0; font-size: 15px; font-weight: 500; letter-spacing: -.02em; line-height: 1.3; overflow-wrap: anywhere; }
  .post-card-excerpt {
    margin: 4px 0 0; font-size: 13px; line-height: 1.35; color: #8a8a85;
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
  }
  .post-card-arrow { display: none; }
</style>
